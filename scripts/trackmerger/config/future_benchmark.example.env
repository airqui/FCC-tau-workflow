# Copy this file outside the repository, replace every <placeholder>, and keep
# it with the future campaign provenance. It is parsed as KEY=VALUE data; it is
# never sourced as shell code and does not support variable expansion.

BENCHMARK_LABEL=trackmerger_pandora_tau_ab_2000evt_v2

# New pinned software provenance.
KEY4HEP_NIGHTLY=<YYYY-MM-DD-build>
KEY4HEP_SETUP=</exact/key4hep/setup.sh>
K4RECTRACKER_SOURCE=</path/to/pinned/k4RecTracker>
K4RECTRACKER_COMMIT=<40-character-commit>
TRACKMERGER_CPP_SHA256=<64-character-sha256>
ILDCONFIG_SOURCE=</path/to/pinned/ILDConfig>
ILDCONFIG_COMMIT=<40-character-commit>

# Explicit developer-designated B collection and its track-truth relation.
TRACK_COLLECTION=<DeveloperDesignatedMergedTrackCollection>
TRACK_TRUTH_LINK_COLLECTION=<DeveloperDesignatedMergedTrackCollectionMCTruthLink>

# Reviewed isolated B bundle. Pandora and HighLevelReco must both use the
# collection names above. Separate smoke/full steering is allowed and safest;
# they may be the same file only when the event arguments below control EvtMax.
B_SMOKE_STEERING=</path/to/reviewed/ILDReconstruction_B_smoke.py>
B_FULL_STEERING=</path/to/reviewed/ILDReconstruction_B_2000.py>
B_PANDORA_CONFIG=</path/to/reviewed/ParticleFlow/PandoraPFA.py>
B_HIGHLEVEL_CONFIG=</path/to/reviewed/HighLevelReco/HighLevelReco_FCCee.py>
RECONSTRUCTION_WORKDIR=</path/to/pinned/ILDConfig/StandardConfig/production>

# The driver requires visible event control. Leave these empty when the reviewed
# steering contains literal ApplicationMgr EvtMax values (the v1 pattern). Only
# set them to event-limit options actually supported by the selected k4run.
SMOKE_EVENTS=10
SMOKE_EVENT_ARGS=
FULL_EVENT_ARGS=

# Must be a new B-only root. Never use the frozen A directory.
B_OUTPUT_ROOT=</new/non-colliding/B-only/output/root>

# Frozen maintained analysis implementation and benchmark-v1 source config.
TAUSFCCEE_REPO=/lhome/ific/a/airqui/FCC/TausFCCee
FROZEN_ANALYSIS_CONFIG=/lhome/ific/a/airqui/FCC/trackmerger_pandora_ab/analysis/benchmark2000/comparison_config.yaml
