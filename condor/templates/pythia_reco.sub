# Supply repo_root, log_dir and queue_file with condor_submit -append.
universe = vanilla
executable = $(repo_root)/condor/wrappers/run_pythia_reco_job.sh
arguments = $(input_file) $(ClusterId).$(Process)
environment = "OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 ROOT_MAX_THREADS=1 PYTHON_CPU_COUNT=1 TBB_NUM_THREADS=1"
output = $(log_dir)/production.$(ClusterId).$(Process).out
error  = $(log_dir)/production.$(ClusterId).$(Process).err
log    = $(log_dir)/production.$(ClusterId).log
should_transfer_files = NO
request_cpus   = 1
request_memory = 4 GB
request_disk   = 4 GB
+JobFlavour = "tomorrow"
+JobBatchName = "fcc-pythia8-ourreco-production"
queue input_file from $(queue_file)
